          "const method = pm.request.method.toUpperCase();",
          "if (!['GET','HEAD','OPTIONS','TRACE'].includes(method)) {",
          "  const base = pm.environment.get('baseUrl');",
          "  if (!/^https:\\/\\/(localhost|127\\.0\\.0\\.1)(:\\d+)?$/.test(base || '')) throw new Error('Configure a trusted local HTTPS baseUrl.');",
          "  pm.sendRequest({ url: base + '/api/v1/identity/csrf', method: 'GET' }, (error, response) => {",
          "    if (error || response.code !== 200) throw new Error('CSRF bootstrap failed.');",
          "    const csrf = response.json();",
          "    pm.request.headers.upsert({ key: csrf.headerName, value: csrf.requestToken });",
          "  });",
          "}"
        ]
      },
      "listen": "prerequest"
    }
