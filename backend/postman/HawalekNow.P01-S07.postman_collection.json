              "if (expected === 404) { const p = pm.response.json(); pm.test('Hidden docs use safe 404', () => { pm.expect(p.code).to.equal('resource.not_found'); pm.expect(p.status).to.equal(404); pm.expect(p.correlationId).to.equal(pm.response.headers.get('X-Correlation-ID')); }); }",
              "if (expected === 200) { const d = pm.response.json(); pm.test('Real paths only', () => pm.expect(Object.keys(d.paths)).to.include.members(['/api/v1/health/live','/api/v1/identity/login','/api/v1/identity/recovery/verify'])); pm.test('Health contracts', () => pm.expect(Object.keys(d.paths['/api/v1/health/live'].get.responses).sort()).to.eql(['200','500','503'])); }"
            ]
