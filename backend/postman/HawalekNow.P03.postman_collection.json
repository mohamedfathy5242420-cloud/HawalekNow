{
  "info": {
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "name": "HawalekNow P03 reference data and locations",
    "description": "P03 is in progress. Only implemented endpoints are included. Use a dedicated isolated review database with a test Admin and HTTPS certificate validation enabled. These are selected journey requests, not a blind full-collection runner. Mutation CSRF is refreshed for the current cookie jar. Credentials and captured ids are intentionally empty; never export a filled environment. Later P03 steps extend this same collection."
  },
  "event": [
    {
      "script": {
        "type": "text/javascript",
        "exec": [
          "const method = pm.request.method.toUpperCase();",
          "if (!['GET','HEAD','OPTIONS','TRACE'].includes(method)) {",
          "  const base = pm.environment.get('baseUrl');",
          "  if (!/^https:\\/\\/(localhost|127\\.0\\.0\\.1)(:\\d+)?$/.test(base || '')) throw new Error('Configure a trusted local HTTPS baseUrl.');",
          "  pm.sendRequest({ url: base + '/api/v1/identity/csrf', method: 'GET' }, (error, response) => {",
          "    if (error || response.code !== 200) throw new Error('CSRF bootstrap failed.');",
          "    const csrf = response.json();",
          "    pm.request.headers.upsert({ key: csrf.headerName, value: csrf.requestToken });",
          "  });",
          "}"
        ]
      },
      "listen": "prerequest"
    }
  ],
  "item": [
    {
      "item": [
        {
          "name": "CSRF bootstrap",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Correlation-ID",
                "value": "{{correlationId}}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/identity/csrf"
          },
          "event": [
            {
              "script": {
                "exec": [
                  "pm.test('Expected HTTP status', () => pm.response.to.have.status(200));",
                  "pm.test('Correlation header', () => pm.expect(pm.response.headers.get('X-Correlation-ID')).to.match(/^[A-Za-z0-9_-]{1,64}$/));"
                ],
                "type": "text/javascript"
              },
              "listen": "test"
            }
          ]
        },
        {
          "name": "Test Admin login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Correlation-ID",
                "value": "{{correlationId}}"
