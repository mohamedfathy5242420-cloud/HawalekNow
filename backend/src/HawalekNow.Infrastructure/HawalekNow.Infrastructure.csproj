<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="[8.19.2]" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="[10.0.14]" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="[10.0.14]" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer.NetTopologySuite" Version="[10.0.14]" />
    <PackageReference Include="NetTopologySuite" Version="[2.6.0]" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="[10.0.14]" PrivateAssets="all" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="[10.0.14]" />
    <PackageReference Include="Hangfire.AspNetCore" Version="[1.8.25]" />
    <PackageReference Include="Hangfire.SqlServer" Version="[1.8.25]" />
    <PackageReference Include="Newtonsoft.Json" Version="[13.0.4]" />
    <PackageReference Include="Magick.NET-Q8-AnyCPU" Version="[15.1.0]" />
    <ProjectReference Include="..\HawalekNow.Application\HawalekNow.Application.csproj" />
    <ProjectReference Include="..\HawalekNow.Domain\HawalekNow.Domain.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Modules/Locations/SeedData/*.json" LogicalName="HawalekNow.ReferenceSeed.%(Filename)%(Extension)" />
    <Content Include="Modules/Locations/SeedData/LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Modules/Locations/SeedData/SOURCE.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Shared/Storage/ThirdParty/Magick.NET-15.1.0.LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" TargetPath="ThirdParty/Magick.NET-15.1.0.LICENSE.txt" />
    <Content Include="Shared/Storage/ThirdParty/Magick.NET-15.1.0.NOTICE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" TargetPath="ThirdParty/Magick.NET-15.1.0.NOTICE.txt" />
  </ItemGroup>

</Project>
